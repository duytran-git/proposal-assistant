# =============================================================
# Proposal Assistant — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Uncomment to override defaults.

# --- Slack (Required) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# --- Google (Required) ---
# Full JSON content of service account key (inline, single line)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-shared-drive-folder-id

# --- Google Slides Template ---
# Local PPTX template (preferred — uploaded & auto-converted to Google Slides)
PROPOSAL_TEMPLATE_PATH=template/Renessai basic template 10_2025.pptx
# Optional fallback: existing Google Slides template ID (used only if local file not found)
# PROPOSAL_TEMPLATE_SLIDE_ID=your-template-presentation-id

# --- LLM — Anthropic (Required) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key

# --- LLM Tuning (Optional — uncomment to override defaults) ---
# Model to use for all LLM calls
# Available: claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001, claude-opus-4-20250514
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Max output tokens per LLM response (higher = longer responses but more cost)
# ANTHROPIC_MAX_TOKENS=4096

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
# Lower values produce more consistent outputs; higher values add variety
# ANTHROPIC_TEMPERATURE=0.3

# Number of retry attempts on transient LLM errors
# ANTHROPIC_MAX_RETRIES=3

# Retry backoff delays in seconds (comma-separated, one per retry)
# ANTHROPIC_RETRY_BACKOFF=1,2,4

# Token threshold before transcripts get chunk-summarized
# Increase if your transcripts are large and you want full-context analysis
# ANTHROPIC_CHUNK_THRESHOLD=32000

# Token size per chunk when splitting long transcripts
# ANTHROPIC_CHUNK_SIZE=8000

# --- App Settings (Optional) ---
ENVIRONMENT=production
LOG_LEVEL=INFO
BOT_ENABLED=true

# --- Alerting (Optional) ---
# Slack channel for system alerts (errors, health check failures)
# SLACK_ALERT_CHANNEL=#proposal-assistant-alerts

# =============================================================
# REMOVED — these are from the old Ollama architecture:
# OLLAMA_BASE_URL, OLLAMA_MODEL, OLLAMA_NUM_CTX, OPENAI_API_KEY
# =============================================================
